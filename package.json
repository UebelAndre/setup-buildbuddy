{
  "name": "setup-buildbuddy",
  "version": "0.0.0",
  "private": true,
  "description": "GitHub Action that configures Bazel to use BuildBuddy with the right API key for the job",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "ncc build src/index.ts -o dist --license licenses.txt",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "npm run lint:ts && npm run lint:format && npm run lint:shell && npm run lint:actions",
    "lint:ts": "eslint .",
    "lint:format": "prettier --check .",
    "lint:shell": "shellcheck tools/*.sh .github/scripts/*.sh",
    "lint:actions": "actionlint",
    "format": "eslint --fix . && prettier --write .",
    "all": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@actions/core": "^1.11.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "@vercel/ncc": "^0.38.3",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
